<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E9EFF4" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#DCE5EC" />
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#E7EBEF" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputFocusedBrush" Color="#F7FBFD" />

    <SolidColorBrush x:Key="BorderBrush" Color="#CBD4DD" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#AEB9C4" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#7D909F" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#16212B" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#2F3C48" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6975" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7B8792" />

    <SolidColorBrush x:Key="AccentBrush" Color="#1677A8" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0E6B99" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#0B5B82" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#DCEEF7" />
    <SolidColorBrush x:Key="AccentSurfaceHoverBrush" Color="#CCE6F3" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#5FA7C9" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CFE7F3" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#16212B" />
    <SolidColorBrush x:Key="FocusBrush" Color="#1677A8" />

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#E2E7EC" />
    <SolidColorBrush x:Key="ScrollTrackHoverBrush" Color="#D5DDE4" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#AAB6C1" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#8F9EAB" />
    <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="#1677A8" />
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SliderThumbHoverBrush" Color="#EAF5FA" />
    <SolidColorBrush x:Key="SliderThumbPressedBrush" Color="#D9EEF7" />

    <SolidColorBrush x:Key="ViewerCanvasBaseBrush" Color="#E2E6EA" />
    <SolidColorBrush x:Key="ViewerCanvasTileBrush" Color="#F0F2F4" />
    <SolidColorBrush x:Key="ThumbnailSurfaceBrush" Color="#F8FAFB" />
    <SolidColorBrush x:Key="ThumbnailImageBackgroundBrush" Color="#EEF1F4" />

    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#C8D2DB" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#16212B" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#E8F2F8" />
    <SolidColorBrush x:Key="MenuDisabledForegroundBrush" Color="#84909B" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#D4DCE4" />

    <!-- 画布浮层：始终半透明，覆盖在图片上方 -->
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#EAFFFFFF" />
    <SolidColorBrush x:Key="OverlaySurfaceRaisedBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#B4C0CB" />
    <SolidColorBrush x:Key="OverlayBorderSubtleBrush" Color="#D2DAE2" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#16212B" />
    <SolidColorBrush x:Key="OverlaySecondaryTextBrush" Color="#54626E" />
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#33000000" />
    <SolidColorBrush x:Key="CropHandleBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CropHandleBorderBrush" Color="#16212B" />
    <SolidColorBrush x:Key="CropSelectionFillBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="CropSelectionStrokeBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FavoriteSurfaceBrush" Color="#EAFFF3D6" />
    <SolidColorBrush x:Key="FavoriteBorderBrush" Color="#D5A329" />
    <SolidColorBrush x:Key="FavoriteGlyphBrush" Color="#B37C00" />

    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#E6F3F8" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#98C5D8" />
    <SolidColorBrush x:Key="InfoTitleBrush" Color="#0D6189" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#294B5A" />
    <SolidColorBrush x:Key="PerformanceCalloutSurfaceBrush" Color="#FFF7EA" />
    <SolidColorBrush x:Key="PerformanceCalloutBorderBrush" Color="#E6B969" />
    <SolidColorBrush x:Key="PerformanceCalloutTitleBrush" Color="#875500" />
    <SolidColorBrush x:Key="PerformanceCalloutTextBrush" Color="#5C4B31" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF3D6" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#D5A329" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#745500" />

    <!-- 与主题无关的共享基元：两个主题字典里保持完全相同的取值。
         放在主题字典而不是 App.xaml，是为了让只合并主题字典的场景（例如 smoke test）也能解析。 -->
    <CornerRadius x:Key="ContainerCornerRadius">8</CornerRadius>
    <DropShadowEffect x:Key="OverlayShadow"
                      BlurRadius="18"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#90000000"
                      Opacity="0.34" />
    <!-- 图标字形：显式样式不会继承隐式 TextBlock 样式，这里单独指定图标字体 -->
    <Style x:Key="GlyphText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE7F3" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#16212B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#16212B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#F3F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#16212B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#16212B" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#84909B" />
</ResourceDictionary>
