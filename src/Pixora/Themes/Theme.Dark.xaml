<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#101216" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171A20" />
    <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#1C2028" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#242B36" />
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="#202630" />
    <SolidColorBrush x:Key="SurfaceDisabledBrush" Color="#141820" />
    <SolidColorBrush x:Key="InputBrush" Color="#101216" />
    <SolidColorBrush x:Key="InputFocusedBrush" Color="#121820" />

    <SolidColorBrush x:Key="BorderBrush" Color="#2F3B48" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#465160" />
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#5B6A7D" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F5F7" />
    <SolidColorBrush x:Key="TextBodyBrush" Color="#DCE4EC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB8C4" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#788290" />

    <SolidColorBrush x:Key="AccentBrush" Color="#65BFF2" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8FD7FF" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4FA5D6" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#213142" />
    <SolidColorBrush x:Key="AccentSurfaceHoverBrush" Color="#26394B" />
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#315B70" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#101216" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#2D4A62" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FocusBrush" Color="#8FD7FF" />

    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#11151B" />
    <SolidColorBrush x:Key="ScrollTrackHoverBrush" Color="#151B24" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#536174" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#65758A" />
    <SolidColorBrush x:Key="ScrollThumbActiveBrush" Color="#78C8F8" />
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#EAF7FF" />
    <SolidColorBrush x:Key="SliderThumbHoverBrush" Color="#CDEFFF" />
    <SolidColorBrush x:Key="SliderThumbPressedBrush" Color="#BFDFFF" />

    <SolidColorBrush x:Key="ViewerCanvasBaseBrush" Color="#171A20" />
    <SolidColorBrush x:Key="ViewerCanvasTileBrush" Color="#20242C" />
    <SolidColorBrush x:Key="ThumbnailSurfaceBrush" Color="#181C23" />
    <SolidColorBrush x:Key="ThumbnailImageBackgroundBrush" Color="#101216" />

    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#242832" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#3A404C" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#F2F5F7" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#313847" />
    <SolidColorBrush x:Key="MenuDisabledForegroundBrush" Color="#788290" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#4A5260" />

    <!-- 画布浮层：始终半透明，覆盖在图片上方 -->
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#D8101216" />
    <SolidColorBrush x:Key="OverlaySurfaceRaisedBrush" Color="#D8171C24" />
    <SolidColorBrush x:Key="OverlayBorderBrush" Color="#4B5665" />
    <SolidColorBrush x:Key="OverlayBorderSubtleBrush" Color="#26313C" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="#F2F5F7" />
    <SolidColorBrush x:Key="OverlaySecondaryTextBrush" Color="#B9C4D0" />
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#33000000" />
    <SolidColorBrush x:Key="CropHandleBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="CropHandleBorderBrush" Color="#101216" />
    <SolidColorBrush x:Key="CropSelectionFillBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="CropSelectionStrokeBrush" Color="#F4F6F8" />
    <SolidColorBrush x:Key="FavoriteSurfaceBrush" Color="#DA27210F" />
    <SolidColorBrush x:Key="FavoriteBorderBrush" Color="#D9B24F" />
    <SolidColorBrush x:Key="FavoriteGlyphBrush" Color="#FFD66B" />

    <SolidColorBrush x:Key="InfoSurfaceBrush" Color="#142733" />
    <SolidColorBrush x:Key="InfoBorderBrush" Color="#315B70" />
    <SolidColorBrush x:Key="InfoTitleBrush" Color="#77CFFC" />
    <SolidColorBrush x:Key="InfoTextBrush" Color="#C8D5DE" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#DA27210F" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#D9B24F" />
    <SolidColorBrush x:Key="WarningTextBrush" Color="#FFD66B" />

    <!-- 与主题无关的共享基元：两个主题字典里保持完全相同的取值。
         放在主题字典而不是 App.xaml，是为了让只合并主题字典的场景（例如 smoke test）也能解析。 -->
    <CornerRadius x:Key="ContainerCornerRadius">8</CornerRadius>
    <DropShadowEffect x:Key="OverlayShadow"
                      BlurRadius="18"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#90000000"
                      Opacity="0.34" />
    <!-- 图标字形：显式样式不会继承隐式 TextBlock 样式，这里单独指定图标字体 -->
    <Style x:Key="GlyphText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#2D4A62" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#171A20" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#101216" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#F2F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#242832" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#F2F5F7" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#788290" />
</ResourceDictionary>
